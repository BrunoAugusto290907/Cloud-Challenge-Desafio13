# Copie para .env (que NUNCA vai para o Git) e ajuste os valores.
DATABASE_URL=postgres://usuario:senha@localhost:5432/avalie
# Local: false. No Azure PostgreSQL: deixe em branco (SSL ligado).
DATABASE_SSL=false
# Token simples usado pelo gestor na moderacao (header x-gestor-token)
GESTOR_TOKEN=troque-este-valor
PORT=3000
